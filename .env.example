# Copy this file to `.env.local` and fill in your Supabase project values.
# Supabase dashboard -> Project Settings -> API
#
# The site is fully functional without these: if they are missing the app
# silently renders the local fallback content from src/data/portfolio.js.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
